#include "stm32f407xx.h"


#define LOW 0
#define BTN_PRESSED LOW

void delay(void)
{
	// this will introduce ~200ms delay when system clock is 16MHz
	for(uint32_t i = 0 ; i < 500000/2 ; i ++);
}


int main(void)
{

	GPIO_Handle_t GpioLed, GPIOBtn;
	memset(&GpioLed,0,sizeof(GpioLed));
	memset(&GPIOBtn,0,sizeof(GpioLed));
	GpioLed.pGPIOx = GPIOA;
	GpioLed.Init.Pin = GPIO_PIN_8;
	GpioLed.Init.Mode = GPIO_MODE_OUTPUT;
	GpioLed.Init.Speed = GPIO_SPEED_FAST;
	GpioLed.Init.OPType = GPIO_OPTYPE_PP;
	GpioLed.Init.Pull = GPIO_NOPULL;

	GPIO_Init(&GpioLed);

	//this is btn gpio configuration
	GPIOBtn.pGPIOx = GPIOD;
	GPIOBtn.Init.Pin = GPIO_PIN_5;
	GPIOBtn.Init.Mode = GPIO_MODE_IT_FALLING;
	GPIOBtn.Init.Pull = GPIO_PULLUP;


	GPIO_Init(&GPIOBtn);

	GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_RESET);

	//IRQ configurations
	GPIO_IRQPriorityConfig(IRQ_NO_EXTI9_5, NVIC_IRQ_PRI15);
	GPIO_IRQInterruptConfig(IRQ_NO_EXTI9_5, ENABLE);

	while(1);
	return 0;
}

void EXTI9_5_IRQHandler(void)
{
   /// delay(); //200ms . wait till button de-bouncing gets over
	GPIO_IRQHander(GPIO_PIN_NO_5); //clear the pending event from exti line
	GPIO_ToggleOutputPin(GPIOD,GPIO_PIN_NO_12);
}
